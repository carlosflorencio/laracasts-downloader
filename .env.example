# === Laracasts account (required) ===
EMAIL=user@test.com
PASSWORD=password

# === Paths (required) ===
# Base folder downloads are written under; relative to the project root or
# absolute (e.g. Downloads, .., D:/Media/laracasts).
LOCAL_PATH=Downloads
# Subfolder holding the per-series folders: <LOCAL_PATH>/<SERIES_FOLDER>/<slug>/
SERIES_FOLDER=series
# Legacy/unused, but bootstrap.php still reads it, so keep it set.
LESSONS_FOLDER=lessons

# === General ===
# Any PHP timezone id (https://www.php.net/timezones): UTC, Europe/London,
# America/New_York, ... (required)
TIMEZONE=Europe/London

# Preferred video height; falls back to the highest available if missing or not
# offered. Typical: 360p, 480p, 720p, 1080p, 1440p, 2160p (Cloudflare lessons
# may offer up to 2160p). Default: highest available.
VIDEO_QUALITY=1080p

# Audio track for series that ship dubbed audio. Values: es, pt, de, ja.
# Default (unset): the original English audio.
# AUDIO_LANGUAGE=

# === Download source ===
# Where the video stream comes from:
#   mux       signed Mux HLS, remuxed with ffmpeg (recommended; needs ffmpeg)
#   external  hand the HLS url to EXTERNAL_TOOL (e.g. yt-dlp) instead
#   laracasts the site download button (legacy; ~30/day cap, fixed quality)
#   vimeo     legacy; Laracasts no longer streams from Vimeo (non-functional)
# mux and external also auto-detect lessons migrated to the Cloudflare CDN
# (media.laracasts.com) and fetch those — no extra config needed.
# Default when unset: laracasts. Recommended: mux.
DOWNLOAD_SOURCE=external

# === External tool (used only when DOWNLOAD_SOURCE=external) ===
# The signed Mux/Cloudflare HLS url is passed to this tool (must accept
# `-o <file> <url>`); the Cloudflare login cookie is forwarded for you.
# Binary name or full path. Default: yt-dlp
# EXTERNAL_TOOL=yt-dlp
# Extra arguments appended verbatim, e.g. "-v" or "--limit-rate 5M". Default: (empty)
# EXTERNAL_TOOL_ARGS=
# On failure, retry with the built-in mux downloader. true/false. Default: false
# EXTERNAL_TOOL_FALLBACK=false

# === Subtitles ===
# How lesson captions are delivered:
#   sidecar (alias file)       save .srt files in a "subs" subfolder (VLC labels
#                              .srt by language; source .vtt is converted to .srt)
#   embed   (alias true)       mux the tracks into the mp4 as mov_text streams
#   both                       embed and sidecar
#   off     (alias false/none) disable
# Default (unset or unrecognised): sidecar
# DOWNLOAD_SUBTITLES=sidecar
# Caption languages to keep: comma list (e.g. en,es,pt), 'all' for every track,
# or unset for only the default/original track (normally English).
# Default (unset): original track only.
# SUBTITLE_LANGUAGE=

# === Chapters (built from transcript topics) ===
#   embed (alias true)  bake the markers into the mp4
#   file                save a NN-title.chapters.txt ffmetadata sidecar in a
#                       "chapters" subfolder
#   both                embed and sidecar
#   off                 disable
# Default (unset): off
# DOWNLOAD_CHAPTERS=embed

# === Post-processing ===
# Write lesson number (track), series title (album), lesson title and instructor
# (artist) into each mp4's tags via a final ffmpeg pass. true/false. Default: false
# WRITE_METADATA=true
# (Re)generate a "#<slug>.m3u8" playlist in each series folder, listing its
# episode mp4s in order. true/false. Default: false
# WRITE_PLAYLIST=true
