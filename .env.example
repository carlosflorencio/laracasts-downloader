EMAIL=test.com
PASSWORD=password
LOCAL_PATH=Downloads
LESSONS_FOLDER=lessons
SERIES_FOLDER=series
TIMEZONE=Europe/London
# Preferred height; falls back to the highest available. Cloudflare-hosted
# lessons may offer up to 2160p.
VIDEO_QUALITY=1080p

# Audio language for series with dubbed tracks (es, pt, de, ja).
# Leave unset for the original (English) audio
# AUDIO_LANGUAGE=
# mux/external auto-detect lessons that Laracasts has migrated to its
# Cloudflare CDN (media.laracasts.com) and download those instead; no extra
# config is needed as the migration rolls out per-lesson.
DOWNLOAD_SOURCE=mux
# DOWNLOAD_SOURCE=laracasts
# DOWNLOAD_SOURCE=external

# Settings for DOWNLOAD_SOURCE=external: the signed Mux / Cloudflare HLS url is
# handed to an external tool (yt-dlp recommended; must accept `-o <file> <url>`).
# Cloudflare lessons are cookie-gated, so the login cookie is forwarded for you.
# EXTERNAL_TOOL=yt-dlp
# EXTERNAL_TOOL_ARGS=
# Retry failed episodes with the built-in mux downloader (true/false)
# EXTERNAL_TOOL_FALLBACK=false
# Download subtitles when available (true/false, default: false)
# DOWNLOAD_SUBTITLES=true

# Chapter markers built from the transcript topics (default: off)
# embed = bake into the mp4, file = save a NN-title.chapters.txt ffmetadata
# sidecar for manual ffmpeg merging, both = embed + sidecar (the sidecar then
# goes into a #merged subfolder since its chapters are already embedded)
# DOWNLOAD_CHAPTERS=embed
